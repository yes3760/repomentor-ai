# Tüm değişkenler isteğe bağlıdır. Hiçbiri olmadan uygulama kural tabanlı modda tam çalışır.
# Kopyalayın: cp .env.example .env  (.env dosyası .gitignore'dadır)

# Ücretsiz bulut LLM anahtarları (birini doldurmanız yeterli)
GROQ_API_KEY=          # https://console.groq.com/keys
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=    # https://openrouter.ai/keys  (yalnızca :free modeller kullanılır)

# Ollama farklı bir adreste çalışıyorsa (varsayılan http://localhost:11434)
OLLAMA_BASE_URL=

# GitHub API limiti saatte 60 istekten 5000'e çıkar (isteğe bağlı, yalnızca okuma izni yeter)
GITHUB_TOKEN=
